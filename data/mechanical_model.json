    "T_kelvin": 300.0,
    "T_rationale": "300 K is the temperature of the pnas.95.14.8052 experiments, i.e. the temperature at which the sourced persistence lengths were measured.",
    "laws": {
      "wlc": "f = (kT/A) * [ 1/(4(1-y)^2) - 1/4 + y ],  y = z/Lc  (Marko-Siggia)",
      "ewlc": "z/Lc = y(f) + f/K0  -- entropic + enthalpic; no contour ceiling"
    }
  },
