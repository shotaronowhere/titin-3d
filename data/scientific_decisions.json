      "ruling": {
        "coordinate_frame": "canonical human UniProt Q8WZ42-1 sequence version 4; 34350 aa",
        "region_partition": {
          "prox_Ig": "801-9365; 74 contained UniProt Ig-like rows",
          "N2A": "9366-9851; I80-UN2A-I81-I82-I83; four curated Ig folds",
          "post_N2A_unknown": "9852-10215; structure, identity, contour, and mechanics UNKNOWN",
          "PEVK": "10216-12022; 31 UniProt PEVK-repeat rows",
          "dist_Ig": "12023-14018; 16 contained UniProt Ig-like rows; A/I nomenclature unresolved"
        },
        "count_policy": "Store UniProt feature, curated biological, and rendered counts independently; preserve the experimental I81/UniProt I82 overlap as a source conflict.",
        "implementation_record": "docs/scientific-decisions/SC-20/OWNER-AUTHORIZED-RULINGS.md#sd-01--approved-with-a-conservative-coordinate-policy"
      },
      "public_caveat": "N2A is shown as the human I80-UN2A-I81-I82-I83 element. Canonical Q8WZ42-1 coordinates are used under an explicit project boundary policy; the I81/I82 source overlap and the following 9852-10215 interval remain unresolved, and no conformation or mechanics is assigned to that interval.",
      "dissent_or_uncertainty": [
        "The 9366 N2A start is a conservative reproducible project boundary at the UniProt I80 feature, not a uniquely established biological boundary.",
        "The exact distal-Ig/A-I nomenclature crosswalk remains unresolved."
      ],
