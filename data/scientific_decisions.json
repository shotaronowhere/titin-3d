      "reviewed_model_fingerprint": "7c32782023041e9e4ced13b30828ffadda11f08e6b744d1a6857cfbb18a68d5c",
      "reviewed_payload_sha256": "6fb8f0c56935528ab17774d6177fe4d39423b1ce149528a1506c4fa6ad556182",
      "ruling": {
        "required_distinct_fields": [
          "c_zone_sequence_super_repeat_domain_count",
          "rabbit_psoas_mean_titin_domain_spacing_nm",
          "derived_11_domain_interval_nm",
          "myosin_head_H_periodicity_nm",
          "myosin_crown_spacing_nm",
          "thick_filament_L_periodicity_nm",
          "L_periodicity_titin_origin_hypothesis"
        ],
        "forbidden_identity": "45.5 nm is not the exact molecular length of an 11-domain titin repeat and is not interchangeable with H periodicity, crown spacing, or the derived 11-domain interval.",
        "implementation_record": "docs/scientific-decisions/SC-20/OWNER-AUTHORIZED-RULINGS.md#sd-03--approved-with-physically-distinct-fields"
      },
      "public_caveat": "Titin's C-zone sequence repeats every 11 domains. In fixed rabbit-psoas rigor myofibrils, an antibody-localization regression gives a mean axial domain spacing of 3.98 nm, implying about 43.8 nm per 11-domain interval. Separately, near-physiological-temperature diffraction resolves an approximately 43.1 nm myosin helical periodicity and an approximately 45.5 nm purely axial thick-filament periodicity. A titin contribution to the latter is a structural hypothesis, not an exact molecular-length or register measurement.",
      "dissent_or_uncertainty": [
        "The source preparations differ and none establishes one universal human axial register."
      ],
